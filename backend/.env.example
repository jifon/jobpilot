# Скопируйте в .env и заполните. Файл .env не коммитить!
ANTHROPIC_API_KEY=sk-ant-...

# Модели
MODEL_FAST=claude-haiku-4-5
MODEL_SMART=claude-sonnet-5

# База данных
DATABASE_URL=sqlite:///./data/jobpilot.db

# Порог, ниже которого аналитик отсеивает вакансию без вызова LLM (0-100)
PREFILTER_MIN_SCORE=30
